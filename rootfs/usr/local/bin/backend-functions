#!/bin/sh
# shellcheck shell=sh

setcap_net_bind="${SETCAP_NET_BIND:-1}"
setcap_net_admin="${SETCAP_NET_ADMIN:-1}"
vpn_subnet="${VPN_SUBNET:-10.10.10.0/24}"
wan_if="${WAN_IF:-}"
if [ -z "$wan_if" ]; then
    # Auto-detect the WAN interface from the IPv4 default route. In a plain
    # bridge network that is eth0, but with extra networks attached (e.g. a
    # macvlan for the ISP uplink) the ISP-facing interface may be eth1 or
    # later - Docker attaches networks in lexicographic order, so the name is
    # not stable. The default route always points out the "outside".
    wan_if="$(ip -4 route show default 2>/dev/null \
        | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')"
    wan_if="${wan_if:-eth0}"
fi
vpn_if="${VPN_IF:-vpns+}"
vpn_gateway="${VPN_GATEWAY:-}"
vpn_gateway6="${VPN_GATEWAY6:-}"
vpn_gateway_table="${VPN_GATEWAY_TABLE:-100}"
vpn_gateway_rule_prio="${VPN_GATEWAY_RULE_PRIO:-1000}"
vpn_gateways="${VPN_GATEWAYS:-}"
vpn_gateways6="${VPN_GATEWAYS6:-}"
vpn_user_gateway="${VPN_USER_GATEWAY:-}"
vpn_user_gateway_file="${VPN_USER_GATEWAY_FILE:-}"
vpn_user_gateway_watch="${VPN_USER_GATEWAY_WATCH:-0}"
vpn_gateway_user_rule_prio="${VPN_GATEWAY_USER_RULE_PRIO:-900}"

# VPN_GATEWAY=direct is an explicit alias for "no default gateway": unmapped
# users exit via the container's default route (the ISP)
[ "$vpn_gateway" = "direct" ] && vpn_gateway=""
[ "$vpn_gateway6" = "direct" ] && vpn_gateway6=""

# Runtime state shared between init-vpngw and the ocserv connect/disconnect hook
vpngw_state_dir="/run/ocserv-vpngw"
ipv6_forward="${IPV6_FORWARD:-1}"
ipv6_nat="${IPV6_NAT:-0}"
ipv6_subnet="${IPV6_SUBNET:-fda9:4efe:7e3b:03ea::/64}"

# Logging functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1"
}

log_error() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >&2
}

# Print "key value" lines from a "key=value,key=value" list
kv_pairs() {
    [ -n "${1:-}" ] || return 0
    echo "$1" | tr ',' '\n' | \
        awk -F= '{ gsub(/[[:space:]]/, "") } $1 != "" && $2 != "" { print $1 " " $2 }'
}

# Print the value for a key in a "key=value,key=value" list (empty if absent)
kv_get() {
    kv_pairs "${1:-}" | awk -v k="$2" '$1 == k { print $2; exit }'
}

# ---- Per-user gateway map: shared helpers ----------------------------------
# Used by init-vpngw (build the map at boot), the connect/disconnect hook
# (apply per-session rules) and vpngw-reload (rebuild + reconcile live sessions).

# Emit "user gateway" lines from a mapping file. One "user gw" or "user=gw" per
# line; blank lines and #-comments ignored; surrounding whitespace trimmed.
vpngw_user_file_pairs() {
    [ -f "$1" ] || return 0
    sed 's/#.*//' "$1" | awk '
        { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
        $0 == "" { next }
        { gsub(/=/, " "); if ($1 != "" && $2 != "") print $1 " " $2 }'
}

# Rebuild $vpngw_state_dir/users from VPN_USER_GATEWAY (env) plus
# VPN_USER_GATEWAY_FILE (file wins on conflict). Validates every gateway name
# against the gateways state and writes the file ATOMICALLY only when all entries
# are valid; on any invalid entry the existing users file is left untouched and
# the function returns 1. An empty map produces an empty users file (so the hook
# stays active and later additions can be applied at runtime).
vpngw_build_users() {
    _merged="$vpngw_state_dir/users.merged.$$"
    _tmp="$vpngw_state_dir/users.new.$$"
    : > "$_merged"
    kv_pairs "$vpn_user_gateway" >> "$_merged"
    if [ -n "$vpn_user_gateway_file" ]; then
        vpngw_user_file_pairs "$vpn_user_gateway_file" >> "$_merged"
    fi
    # Last occurrence wins: env entries first, file entries second => file wins.
    awk '$1 != "" { m[$1] = $2 } END { for (u in m) print u, m[u] }' "$_merged" > "$_tmp"
    rm -f "$_merged"

    _bad=0
    while read -r _u _gw; do
        [ -n "$_u" ] || continue
        [ "$_gw" = "direct" ] && continue
        if ! awk -v n="$_gw" '$1 == n { f = 1 } END { exit !f }' \
            "$vpngw_state_dir/gateways" 2>/dev/null; then
            log_error "[VPNGW] user-gateway map: unknown gateway '$_gw' for user '$_u' (define it in VPN_GATEWAYS)"
            _bad=1
        fi
    done < "$_tmp"

    if [ "$_bad" != 0 ]; then
        rm -f "$_tmp"
        return 1
    fi
    mv "$_tmp" "$vpngw_state_dir/users"
    return 0
}

# Remove every policy rule and kill-switch entry for a session's addresses.
# Idempotent; used on disconnect, before (re)applying a session, and by reload.
#   $1 = IPv4 (may be empty)   $2 = IPv6 (may be empty)
vpngw_cleanup_session() {
    _ip4="${1:-}"
    _ip6="${2:-}"
    _prio="$vpn_gateway_user_rule_prio"
    if [ -n "$_ip4" ]; then
        _n=0
        while [ "$_n" -lt 16 ] && ip rule del from "$_ip4" priority "$_prio" 2>/dev/null; do
            _n=$((_n + 1))
        done
        nft delete element inet ocserv_gw direct_v4 "{ $_ip4 }" 2>/dev/null || true
    fi
    if [ -n "$_ip6" ]; then
        _n=0
        while [ "$_n" -lt 16 ] && ip -6 rule del from "$_ip6" priority "$_prio" 2>/dev/null; do
            _n=$((_n + 1))
        done
        nft delete element inet ocserv_gw direct_v6 "{ $_ip6 }" 2>/dev/null || true
        nft delete element inet ocserv_gw v6_drop "{ $_ip6 }" 2>/dev/null || true
    fi
    if [ -f "$vpngw_state_dir/gateways" ]; then
        while read -r _name _ _ _gw6; do
            [ -n "$_ip4" ] \
                && { nft delete element inet ocserv_gw "gw_${_name}_v4" "{ $_ip4 }" 2>/dev/null || true; }
            [ "$_gw6" != "-" ] && [ -n "$_ip6" ] \
                && { nft delete element inet ocserv_gw "gw_${_name}_v6" "{ $_ip6 }" 2>/dev/null || true; }
        done < "$vpngw_state_dir/gateways"
    fi
    return 0
}

# Install the policy rule + kill-switch entry that steers a session's addresses
# to its gateway. Returns 0 on success, 1 on any failure (the caller is expected
# to clean up and, for the connect hook, reject the session). Does not exit.
#   $1 = username   $2 = gateway name ("direct" or a VPN_GATEWAYS name)
#   $3 = IPv4       $4 = IPv6 (may be empty)
vpngw_apply_session() {
    _u="$1"
    _gw="$2"
    _ip4="$3"
    _ip6="${4:-}"
    _prio="$vpn_gateway_user_rule_prio"

    [ -n "$_ip4" ] || { log_error "[VPNGW] no IPv4 address for user '$_u'"; return 1; }

    if [ "$_gw" = "direct" ]; then
        # Steer to the main table so the session escapes the subnet-wide
        # VPN_GATEWAY rule and exits via the container's default route.
        ip rule add from "$_ip4" lookup main priority "$_prio" || return 1
        nft add element inet ocserv_gw direct_v4 "{ $_ip4 }" || return 1
        if [ -n "$_ip6" ]; then
            ip -6 rule add from "$_ip6" lookup main priority "$_prio" || return 1
            nft add element inet ocserv_gw direct_v6 "{ $_ip6 }" || return 1
        fi
        log "[VPNGW] User '$_u' ($_ip4${_ip6:+, $_ip6}) exits via default route"
        return 0
    fi

    _line="$(awk -v n="$_gw" '$1 == n { print; exit }' "$vpngw_state_dir/gateways" 2>/dev/null)"
    [ -n "$_line" ] || { log_error "[VPNGW] gateway '$_gw' not found in state"; return 1; }
    _table="$(echo "$_line" | awk '{ print $2 }')"
    _gw6="$(echo "$_line" | awk '{ print $4 }')"

    ip rule add from "$_ip4" lookup "$_table" priority "$_prio" || return 1
    nft add element inet ocserv_gw "gw_${_gw}_v4" "{ $_ip4 }" || return 1
    if [ -n "$_ip6" ]; then
        if [ "$_gw6" != "-" ]; then
            ip -6 rule add from "$_ip6" lookup "$_table" priority "$_prio" || return 1
            nft add element inet ocserv_gw "gw_${_gw}_v6" "{ $_ip6 }" || return 1
        else
            # Gateway has no IPv6: drop this session's forwarded IPv6 so it
            # cannot bypass the IPv4-only policy rule.
            nft add element inet ocserv_gw v6_drop "{ $_ip6 }" || return 1
        fi
    fi
    log "[VPNGW] User '$_u' ($_ip4${_ip6:+, $_ip6}) routed via gateway '$_gw' (table $_table)"
    return 0
}
