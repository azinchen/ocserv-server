#!/bin/sh
# shellcheck shell=sh

setcap_net_bind="${SETCAP_NET_BIND:-1}"
setcap_net_admin="${SETCAP_NET_ADMIN:-1}"
vpn_subnet="${VPN_SUBNET:-10.10.10.0/24}"
wan_if="${WAN_IF:-}"
if [ -z "$wan_if" ]; then
    # Auto-detect the WAN interface from the IPv4 default route. In a plain
    # bridge network that is eth0, but with extra networks attached (e.g. a
    # macvlan for the ISP uplink) the ISP-facing interface may be eth1 or
    # later - Docker attaches networks in lexicographic order, so the name is
    # not stable. The default route always points out the "outside".
    wan_if="$(ip -4 route show default 2>/dev/null \
        | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')"
    wan_if="${wan_if:-eth0}"
fi
tcp_mss="${MSS:-}"
vpn_if="${VPN_IF:-vpns+}"
# nftables interface match for the VPN tunnel: translate the iptables-style
# wildcard (vpns+) to nftables syntax (vpns*). Used by init-nat and init-vpngw.
case "$vpn_if" in
    *+) vpn_ifname="${vpn_if%+}*" ;;
    *)  vpn_ifname="$vpn_if" ;;
esac
vpn_gateway="${VPN_GATEWAY:-}"
vpn_gateway6="${VPN_GATEWAY6:-}"
vpn_gateway_table="${VPN_GATEWAY_TABLE:-100}"
vpn_gateway_rule_prio="${VPN_GATEWAY_RULE_PRIO:-1000}"
vpn_gateways="${VPN_GATEWAYS:-}"
vpn_gateways6="${VPN_GATEWAYS6:-}"
vpn_gateways_file="${VPN_GATEWAYS_FILE:-}"
vpn_gateways_resolve_interval="${VPN_GATEWAYS_RESOLVE_INTERVAL:-0}"
vpn_user_gateway="${VPN_USER_GATEWAY:-}"
vpn_user_gateway_file="${VPN_USER_GATEWAY_FILE:-}"
vpn_user_gateway_watch="${VPN_USER_GATEWAY_WATCH:-0}"
vpn_gateway_user_rule_prio="${VPN_GATEWAY_USER_RULE_PRIO:-900}"
cert_watch="${CERT_WATCH:-0}"
cert_watch_interval="${CERT_WATCH_INTERVAL:-0}"
ocserv_config="${OCSERV_CONFIG:-/etc/ocserv/ocserv.conf}"

# Normalise the subnet-default gateway values (unmapped users). Each family
# accepts an IP, "direct" (exit via the container's default route / ISP) or
# "block" ("drop" is an alias; the family is rejected fail-closed):
#   VPN_GATEWAY (v4):  "direct" and unset both mean ISP -> "";  result "", "block", IP
#   VPN_GATEWAY6 (v6): unset means "block" (no IPv6 leak);      result "", "direct", "block", IP
#                      ("" is treated as "block"; "direct" is kept distinct)
case "$vpn_gateway" in
    direct) vpn_gateway="" ;;
    drop)   vpn_gateway="block" ;;
esac
case "$vpn_gateway6" in
    drop) vpn_gateway6="block" ;;
esac

# Runtime state shared between init-vpngw and the ocserv connect/disconnect hook
vpngw_state_dir="/run/ocserv-vpngw"
ipv6_forward="${IPV6_FORWARD:-1}"
ipv6_nat="${IPV6_NAT:-0}"
ipv6_subnet="${IPV6_SUBNET:-fda9:4efe:7e3b:03ea::/64}"

# Logging functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1"
}

log_error() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >&2
}

# Print "key value" lines from a "key=value,key=value" list
kv_pairs() {
    [ -n "${1:-}" ] || return 0
    echo "$1" | tr ',' '\n' | \
        awk -F= '{ gsub(/[[:space:]]/, "") } $1 != "" && $2 != "" { print $1 " " $2 }'
}

# ---- Gateway address resolution --------------------------------------------
# A gateway address may be given as a literal IP or as a DNS name (e.g. the
# Docker service name of an upstream sidecar). Names are resolved to addresses
# at startup and, when VPN_GATEWAYS_RESOLVE_INTERVAL>0, re-resolved periodically
# so a sidecar that restarts with a new IP is followed without a container
# restart (see vpngw_reconcile_gateways).

# True when $1 is a literal IPv4 address.
is_ipv4() {
    case "$1" in
        *[!0-9.]*) return 1 ;;
        *.*.*.*)   return 0 ;;
        *)         return 1 ;;
    esac
}

# True when $1 is a literal IPv6 address (has a colon, only hex/colon/dot).
is_ipv6() {
    case "$1" in
        *:*) case "$1" in *[!0-9A-Fa-f:.]*) return 1 ;; *) return 0 ;; esac ;;
        *)   return 1 ;;
    esac
}

# True when $1 needs no DNS resolution: a reserved keyword, empty, or literal IP.
gw_is_literal() {
    case "$1" in
        ""|block|drop|direct|none) return 0 ;;
    esac
    is_ipv4 "$1" && return 0
    is_ipv6 "$1" && return 0
    return 1
}

# Resolve a DNS name to all addresses of a family, one per line, deduped.
#   $1 = -4|-6   $2 = name
gw_resolve_all() {
    _db="ahostsv4"; [ "$1" = "-6" ] && _db="ahostsv6"
    getent "$_db" "$2" 2>/dev/null | awk '!seen[$1]++ { print $1 }'
}

# Resolve a DNS name to a single address (the first). Prints it and returns 0,
# or prints nothing and returns 1 on failure.
#   $1 = -4|-6   $2 = name
gw_resolve_one() {
    _one="$(gw_resolve_all "$1" "$2" | head -1)"
    [ -n "$_one" ] || return 1
    printf '%s\n' "$_one"
}

# Pick a stable next-hop for a family: keep the current address ($3) if it is
# still one of the name's resolved addresses (avoids needless churn when a name
# has several A/AAAA records and the resolver rotates them); otherwise take the
# first resolved address. Prints the chosen address (returns 0), or nothing
# (returns 1) when the name cannot be resolved at all.
#   $1 = -4|-6   $2 = name   $3 = current address
gw_resolve_stable() {
    _all="$(gw_resolve_all "$1" "$2")"
    [ -n "$_all" ] || return 1
    if printf '%s\n' "$_all" | grep -qxF "$3"; then
        printf '%s\n' "$3"
    else
        printf '%s\n' "$_all" | head -1
    fi
}

# ---- Gateway / user-map config helpers -------------------------------------
# Shared by init-vpngw (build gateways + map at boot), the connect/disconnect
# hook (apply per-session rules) and vpngw-reload (rebuild + reconcile sessions).

# Parse "key value" / "key=value" lines from a file (used for the user map).
# Blank lines and #-comments ignored; surrounding whitespace trimmed. Emits
# "key value" per entry.
kv_file_pairs() {
    [ -f "$1" ] || return 0
    sed 's/#.*//' "$1" | awk '
        { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
        $0 == "" { next }
        { gsub(/=/, " "); if ($1 != "" && $2 != "") print $1 " " $2 }'
}

# Merge an env "k=v,k=v" list ($1) with a "k v"/"k=v" file ($2, optional) and
# emit sorted "k value" lines, one per key. On a duplicate key the file wins
# (env entries are listed first, so the file's value overwrites). Sorting makes
# the result deterministic (e.g. stable gateway->table assignment within a boot).
kv_merge_env_file() {
    { kv_pairs "$1"; [ -n "$2" ] && kv_file_pairs "$2"; } \
        | awk '$1 != "" { m[$1] = $2 } END { for (k in m) print k, m[k] }' \
        | sort
}

# Parse the gateway definition file: "name ipv4 [ipv6]" per line (also accepts
# "name=ipv4"). Blank lines and #-comments ignored; whitespace trimmed. Emits
# "name ipv4 ipv6" (the IPv6 field empty when the line omits it).
vpngw_gw_file_lines() {
    [ -f "$1" ] || return 0
    sed 's/#.*//' "$1" | awk '
        { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
        $0 == "" { next }
        { gsub(/=/, " "); if ($1 != "" && $2 != "") print $1, $2, $3 }'
}

# Merge the named-gateway definitions from VPN_GATEWAYS (env, name=ipv4),
# VPN_GATEWAYS6 (env, name=ipv6) and VPN_GATEWAYS_FILE (file, "name ipv4 [ipv6]")
# into sorted "name ipv4 ipv6" lines, one per gateway. Merge is per field with
# the file winning: a gateway's IPv4 comes from the file if listed there, else
# from VPN_GATEWAYS; its IPv6 from the file's 3rd column if present, else from
# VPN_GATEWAYS6. Each address is an IP, or "block" (from the reserved keyword
# "block", also accepted as "drop" - that family is blocked for the gateway's
# users). An IPv4 that is never specified is emitted as "none" (invalid; the
# caller errors); an IPv6 that is never specified defaults to "block" (its users'
# IPv6 is blocked, the long-standing behaviour for a v6-less gateway).
#   $1 = VPN_GATEWAYS   $2 = VPN_GATEWAYS6   $3 = VPN_GATEWAYS_FILE (optional)
vpngw_gateways_merged() {
    {
        kv_pairs "$1" | awk '{ print "e4", $1, $2 }'
        kv_pairs "$2" | awk '{ print "e6", $1, $2 }'
        [ -n "$3" ] && vpngw_gw_file_lines "$3" | awk '{ print "f", $1, $2, $3 }'
    } | awk '
        function norm(x) { return (x == "block" || x == "drop") ? "block" : x }
        $1 == "e4" { v4e[$2] = norm($3) }
        $1 == "e6" { v6e[$2] = norm($3) }
        $1 == "f"  { f4[$2] = norm($3); if ($4 != "") f6[$2] = norm($4) }
        END {
            for (n in v4e) names[n] = 1
            for (n in v6e) names[n] = 1
            for (n in f4)  names[n] = 1
            for (n in names) {
                ip4 = (n in f4 ? f4[n] : (n in v4e ? v4e[n] : "none"))
                ip6 = (n in f6 ? f6[n] : (n in v6e ? v6e[n] : "block"))
                print n, ip4, ip6
            }
        }' | sort
}

# Rebuild $vpngw_state_dir/users from VPN_USER_GATEWAY (env) plus
# VPN_USER_GATEWAY_FILE (file wins on conflict). Validates every gateway name
# against the gateways state and writes the file ATOMICALLY only when all entries
# are valid; on any invalid entry the existing users file is left untouched and
# the function returns 1. An empty map produces an empty users file (so the hook
# stays active and later additions can be applied at runtime).
vpngw_build_users() {
    _tmp="$vpngw_state_dir/users.new.$$"
    kv_merge_env_file "$vpn_user_gateway" "$vpn_user_gateway_file" > "$_tmp"

    _bad=0
    while read -r _u _gw; do
        [ -n "$_u" ] || continue
        [ "$_gw" = "direct" ] && continue
        if ! awk -v n="$_gw" '$1 == n { f = 1 } END { exit !f }' \
            "$vpngw_state_dir/gateways" 2>/dev/null; then
            log_error "[VPNGW] user-gateway map: unknown gateway '$_gw' for user '$_u' (define it in VPN_GATEWAYS)"
            _bad=1
        fi
    done < "$_tmp"

    if [ "$_bad" != 0 ]; then
        rm -f "$_tmp"
        return 1
    fi
    mv "$_tmp" "$vpngw_state_dir/users"
    return 0
}

# Remove every policy rule and kill-switch entry for a session's addresses.
# Idempotent; used on disconnect, before (re)applying a session, and by reload.
#   $1 = IPv4 (may be empty)   $2 = IPv6 (may be empty)
vpngw_cleanup_session() {
    _ip4="${1:-}"
    _ip6="${2:-}"
    _prio="$vpn_gateway_user_rule_prio"
    if [ -n "$_ip4" ]; then
        _n=0
        while [ "$_n" -lt 16 ] && ip rule del from "$_ip4" priority "$_prio" 2>/dev/null; do
            _n=$((_n + 1))
        done
        nft delete element inet ocserv_gw direct_v4 "{ $_ip4 }" 2>/dev/null || true
        nft delete element inet ocserv_gw v4_block "{ $_ip4 }" 2>/dev/null || true
    fi
    if [ -n "$_ip6" ]; then
        _n=0
        while [ "$_n" -lt 16 ] && ip -6 rule del from "$_ip6" priority "$_prio" 2>/dev/null; do
            _n=$((_n + 1))
        done
        nft delete element inet ocserv_gw direct_v6 "{ $_ip6 }" 2>/dev/null || true
        nft delete element inet ocserv_gw v6_block "{ $_ip6 }" 2>/dev/null || true
    fi
    # Remove the address from every gateway's set (harmless if it was never a
    # member, e.g. a family the gateway blocks has no gw_<name>_vN set).
    if [ -f "$vpngw_state_dir/gateways" ]; then
        while read -r _name _ _ _; do
            [ -n "$_ip4" ] \
                && { nft delete element inet ocserv_gw "gw_${_name}_v4" "{ $_ip4 }" 2>/dev/null || true; }
            [ -n "$_ip6" ] \
                && { nft delete element inet ocserv_gw "gw_${_name}_v6" "{ $_ip6 }" 2>/dev/null || true; }
        done < "$vpngw_state_dir/gateways"
    fi
    return 0
}

# Install the policy rule + kill-switch entry that steers a session's addresses
# to its gateway. Returns 0 on success, 1 on any failure (the caller is expected
# to clean up and, for the connect hook, reject the session). Does not exit.
#   $1 = username   $2 = gateway name ("direct" or a VPN_GATEWAYS name)
#   $3 = IPv4       $4 = IPv6 (may be empty)
vpngw_apply_session() {
    _u="$1"
    _gw="$2"
    _ip4="$3"
    _ip6="${4:-}"
    _prio="$vpn_gateway_user_rule_prio"

    [ -n "$_ip4" ] || { log_error "[VPNGW] no IPv4 address for user '$_u'"; return 1; }

    if [ "$_gw" = "direct" ]; then
        # Steer to the main table so the session escapes the subnet-wide
        # VPN_GATEWAY rule and exits via the container's default route.
        ip rule add from "$_ip4" lookup main priority "$_prio" || return 1
        nft add element inet ocserv_gw direct_v4 "{ $_ip4 }" || return 1
        if [ -n "$_ip6" ]; then
            ip -6 rule add from "$_ip6" lookup main priority "$_prio" || return 1
            nft add element inet ocserv_gw direct_v6 "{ $_ip6 }" || return 1
        fi
        log "[VPNGW] User '$_u' ($_ip4${_ip6:+, $_ip6}) exits via default route"
        return 0
    fi

    _line="$(awk -v n="$_gw" '$1 == n { print; exit }' "$vpngw_state_dir/gateways" 2>/dev/null)"
    [ -n "$_line" ] || { log_error "[VPNGW] gateway '$_gw' not found in state"; return 1; }
    _table="$(echo "$_line" | awk '{ print $2 }')"
    _gw4="$(echo "$_line" | awk '{ print $3 }')"
    _gw6="$(echo "$_line" | awk '{ print $4 }')"

    # IPv4: route via the gateway table, or (blocked) send to the block set so
    # the kill switch rejects it at the forward hook.
    if [ "$_gw4" != "block" ]; then
        ip rule add from "$_ip4" lookup "$_table" priority "$_prio" || return 1
        nft add element inet ocserv_gw "gw_${_gw}_v4" "{ $_ip4 }" || return 1
    else
        nft add element inet ocserv_gw v4_block "{ $_ip4 }" || return 1
    fi
    # IPv6: same, when the session has an address. "block" covers both an
    # explicitly blocked gateway and a gateway with no IPv6 at all.
    if [ -n "$_ip6" ]; then
        if [ "$_gw6" != "block" ]; then
            ip -6 rule add from "$_ip6" lookup "$_table" priority "$_prio" || return 1
            nft add element inet ocserv_gw "gw_${_gw}_v6" "{ $_ip6 }" || return 1
        else
            nft add element inet ocserv_gw v6_block "{ $_ip6 }" || return 1
        fi
    fi
    log "[VPNGW] User '$_u' ($_ip4${_ip6:+, $_ip6}) routed via gateway '$_gw' (table $_table; v4=$_gw4 v6=$_gw6)"
    return 0
}

# ---- Kill-switch ruleset (inet ocserv_gw) ----------------------------------
# The kill switch is built from state written by init-vpngw:
#   gateways   "name table gw4 gw6" (resolved next-hops; gw4/gw6 an IP or "block")
#   users      present when per-user mode is active (adds direct/block sets)
#   subnet     "gw4 gw6" default for unmapped users; each is an IP, "block",
#              "direct" (v6 only) or "-" (unset/ISP)
# The set declarations and the forward-chain rules are emitted separately so the
# reconciler can rebuild only the chain (flush + re-add) while leaving the named
# sets - and therefore every live session's membership - untouched.

# Emit "set ..." lines for the kill-switch table (named-gateway + user sets).
vpngw_killswitch_sets() {
    if [ -f "$vpngw_state_dir/gateways" ]; then
        while read -r _name _tbl _g4 _g6; do
            [ -n "$_name" ] || continue
            [ "$_g4" != "block" ] && printf 'set gw_%s_v4 { type ipv4_addr; }\n' "$_name"
            [ "$_g6" != "block" ] && printf 'set gw_%s_v6 { type ipv6_addr; }\n' "$_name"
        done < "$vpngw_state_dir/gateways"
    fi
    if [ -f "$vpngw_state_dir/users" ]; then
        printf 'set direct_v4 { type ipv4_addr; }\n'
        printf 'set direct_v6 { type ipv6_addr; }\n'
        printf 'set v4_block { type ipv4_addr; }\n'
        printf 'set v6_block { type ipv6_addr; }\n'
    fi
}

# Emit the forward-chain rule lines (one per line, no leading indent). Order:
# per-gateway next-hop guards + accepts, then direct/block user sets, then the
# subnet default for unmapped users - so per-session rules win over the default.
vpngw_killswitch_rules() {
    _sub4="-"; _sub6="-"
    if [ -f "$vpngw_state_dir/subnet" ]; then
        read -r _sub4 _sub6 < "$vpngw_state_dir/subnet" || true
        [ -n "$_sub4" ] || _sub4="-"
        [ -n "$_sub6" ] || _sub6="-"
    fi
    if [ -f "$vpngw_state_dir/gateways" ]; then
        while read -r _name _tbl _g4 _g6; do
            [ -n "$_name" ] || continue
            if [ "$_g4" != "block" ]; then
                printf 'ip saddr @gw_%s_v4 oifname "%s" rt ip nexthop != %s drop\n' "$_name" "$wan_if" "$_g4"
                printf 'ip saddr @gw_%s_v4 oifname "%s" accept\n' "$_name" "$wan_if"
            fi
            if [ "$_g6" != "block" ]; then
                printf 'ip6 saddr @gw_%s_v6 oifname "%s" rt ip6 nexthop != %s drop\n' "$_name" "$wan_if" "$_g6"
                printf 'ip6 saddr @gw_%s_v6 oifname "%s" accept\n' "$_name" "$wan_if"
            fi
        done < "$vpngw_state_dir/gateways"
    fi
    if [ -f "$vpngw_state_dir/users" ]; then
        printf 'ip saddr @direct_v4 oifname "%s" accept\n' "$wan_if"
        printf 'ip6 saddr @direct_v6 oifname "%s" accept\n' "$wan_if"
        printf 'ip saddr @v4_block reject with icmp type admin-prohibited\n'
        printf 'ip6 saddr @v6_block reject with icmpv6 type admin-prohibited\n'
    fi
    case "$_sub4" in
        -)     : ;;
        block) printf 'ip saddr %s oifname "%s" reject with icmp type admin-prohibited\n' "$vpn_subnet" "$wan_if" ;;
        *)     printf 'ip saddr %s oifname "%s" rt ip nexthop != %s drop\n' "$vpn_subnet" "$wan_if" "$_sub4" ;;
    esac
    case "$_sub6" in
        direct)  : ;;
        -|block) printf 'meta nfproto ipv6 iifname "%s" reject with icmpv6 type admin-prohibited\n' "$vpn_ifname" ;;
        *)       printf 'ip6 saddr %s oifname "%s" rt ip6 nexthop != %s drop\n' "$ipv6_subnet" "$wan_if" "$_sub6" ;;
    esac
}

# Build the whole kill-switch table from scratch (sets + chain). Used at boot.
vpngw_load_killswitch() {
    _sets="$(vpngw_killswitch_sets)"
    _rules="$(vpngw_killswitch_rules)"
    nft delete table inet ocserv_gw 2>/dev/null || true
    nft -f - <<EOF
table inet ocserv_gw {
$(printf '%s' "$_sets" | awk 'NF { print "    " $0 }')
    chain forward {
        type filter hook forward priority -10; policy accept;
$(printf '%s' "$_rules" | awk 'NF { print "        " $0 }')
    }
}
EOF
}

# Rebuild ONLY the forward chain in place (flush + re-add) from current state,
# preserving the named sets and thus every live session's membership. Used by
# the reconciler after a next-hop address changed. Returns nft's exit status.
vpngw_reload_killswitch() {
    _rules="$(vpngw_killswitch_rules)"
    nft -f - <<EOF
flush chain inet ocserv_gw forward
$(printf '%s' "$_rules" | awk 'NF { print "add rule inet ocserv_gw forward " $0 }')
EOF
}

# Re-resolve every DNS-named gateway (named gateways from gateways.src and the
# subnet default from VPN_GATEWAY/VPN_GATEWAY6) and, when a next-hop moved,
# replace that routing table's default route and rebuild the kill-switch chain
# in place. Only ADDRESSES change here: the set of gateway names and their table
# assignments are fixed at boot, so no live session has to migrate. A name that
# fails to resolve keeps its last-known-good address (a transient DNS blip never
# tears routing down). Caller must hold the flock. Always returns 0.
vpngw_reconcile_gateways() {
    [ -d "$vpngw_state_dir" ] || return 0
    _changed=0

    # Named gateways: rewrite the resolved "gateways" file, re-routing on change.
    if [ -f "$vpngw_state_dir/gateways" ] && [ -f "$vpngw_state_dir/gateways.src" ]; then
        _tmp="$vpngw_state_dir/gateways.reconcile.$$"
        : > "$_tmp"
        while read -r _name _tbl _cur4 _cur6; do
            [ -n "$_name" ] || continue
            _srcline="$(awk -v n="$_name" '$1 == n { print $2, $3; exit }' "$vpngw_state_dir/gateways.src")"
            _s4="${_srcline%% *}"
            _s6="${_srcline##* }"
            _new4="$_cur4"; _new6="$_cur6"
            if ! gw_is_literal "$_s4"; then
                if _r="$(gw_resolve_stable -4 "$_s4" "$_cur4")"; then
                    _new4="$_r"
                else
                    log_error "[VPNGW-RESOLVE] gateway '$_name': cannot resolve IPv4 host '$_s4'; keeping $_cur4"
                fi
            fi
            if ! gw_is_literal "$_s6"; then
                if _r="$(gw_resolve_stable -6 "$_s6" "$_cur6")"; then
                    _new6="$_r"
                else
                    log_error "[VPNGW-RESOLVE] gateway '$_name': cannot resolve IPv6 host '$_s6'; keeping $_cur6"
                fi
            fi
            if [ "$_new4" != "block" ] && [ "$_new4" != "$_cur4" ]; then
                if ip route replace default via "$_new4" table "$_tbl"; then
                    log "[VPNGW-RESOLVE] gateway '$_name' IPv4 $_cur4 -> $_new4 (table $_tbl)"
                    _changed=1
                else
                    log_error "[VPNGW-RESOLVE] gateway '$_name': ip route replace via $_new4 failed; keeping $_cur4"
                    _new4="$_cur4"
                fi
            fi
            if [ "$_new6" != "block" ] && [ "$_new6" != "$_cur6" ]; then
                if ip -6 route replace default via "$_new6" table "$_tbl"; then
                    log "[VPNGW-RESOLVE] gateway '$_name' IPv6 $_cur6 -> $_new6 (table $_tbl)"
                    _changed=1
                else
                    log_error "[VPNGW-RESOLVE] gateway '$_name': ip -6 route replace via $_new6 failed; keeping $_cur6"
                    _new6="$_cur6"
                fi
            fi
            printf '%s %s %s %s\n' "$_name" "$_tbl" "$_new4" "$_new6" >> "$_tmp"
        done < "$vpngw_state_dir/gateways"
        mv "$_tmp" "$vpngw_state_dir/gateways"
    fi

    # Subnet default: the source tokens are the env vars themselves.
    if [ -f "$vpngw_state_dir/subnet" ]; then
        read -r _cur4 _cur6 < "$vpngw_state_dir/subnet" || true
        _new4="$_cur4"; _new6="$_cur6"
        if [ -n "$vpn_gateway" ] && ! gw_is_literal "$vpn_gateway"; then
            if _r="$(gw_resolve_stable -4 "$vpn_gateway" "$_cur4")"; then
                _new4="$_r"
            else
                log_error "[VPNGW-RESOLVE] subnet default: cannot resolve IPv4 host '$vpn_gateway'; keeping $_cur4"
            fi
        fi
        if [ -n "$vpn_gateway6" ] && ! gw_is_literal "$vpn_gateway6"; then
            if _r="$(gw_resolve_stable -6 "$vpn_gateway6" "$_cur6")"; then
                _new6="$_r"
            else
                log_error "[VPNGW-RESOLVE] subnet default: cannot resolve IPv6 host '$vpn_gateway6'; keeping $_cur6"
            fi
        fi
        case "$_new4" in
            -|block) : ;;
            *) if [ "$_new4" != "$_cur4" ]; then
                   if ip route replace default via "$_new4" table "$vpn_gateway_table"; then
                       log "[VPNGW-RESOLVE] subnet default IPv4 $_cur4 -> $_new4 (table $vpn_gateway_table)"
                       _changed=1
                   else
                       log_error "[VPNGW-RESOLVE] subnet default: ip route replace via $_new4 failed; keeping $_cur4"
                       _new4="$_cur4"
                   fi
               fi ;;
        esac
        case "$_new6" in
            -|block|direct) : ;;
            *) if [ "$_new6" != "$_cur6" ]; then
                   if ip -6 route replace default via "$_new6" table "$vpn_gateway_table"; then
                       log "[VPNGW-RESOLVE] subnet default IPv6 $_cur6 -> $_new6 (table $vpn_gateway_table)"
                       _changed=1
                   else
                       log_error "[VPNGW-RESOLVE] subnet default: ip -6 route replace via $_new6 failed; keeping $_cur6"
                       _new6="$_cur6"
                   fi
               fi ;;
        esac
        printf '%s %s\n' "$_new4" "$_new6" > "$vpngw_state_dir/subnet"
    fi

    if [ "$_changed" = 1 ]; then
        if vpngw_reload_killswitch; then
            log "[VPNGW-RESOLVE] Kill-switch chain rebuilt for new next-hop(s)"
        else
            log_error "[VPNGW-RESOLVE] Warning: kill-switch chain rebuild failed after re-resolve"
        fi
    fi
    return 0
}

# ---- certificate hot-reload -----------------------------------------------
# ocserv re-reads its server-cert/server-key files on SIGHUP without dropping
# connected clients (existing per-connection workers keep their old cert; new
# connections use the reloaded one). These helpers let cert-reload/svc-cert-watch
# discover which files to watch straight from ocserv.conf, so a renewed cert
# (certbot/SWAG) can be applied with no container restart.

# Print the certificate/key files ocserv loads - one path per line - by reading
# the server-cert and server-key directives from ocserv.conf. Inline "# ..."
# comments and surrounding whitespace are stripped; relative paths are resolved
# against the config file's directory (matching how ocserv reads them).
cert_watch_files() {
    [ -f "$ocserv_config" ] || return 0
    _confdir="$(dirname "$ocserv_config")"
    awk -v cd="$_confdir" '
        {
            line = $0
            sub(/#.*/, "", line)                       # drop inline comments
            if (line !~ /^[[:space:]]*(server-cert|server-key)[[:space:]]*=/)
                next
            sub(/^[^=]*=[[:space:]]*/, "", line)       # keep the value
            sub(/[[:space:]]+$/, "", line)
            if (line == "") next
            if (line !~ /^\//) line = cd "/" line       # resolve relative paths
            print line
        }
    ' "$ocserv_config" | awk '!seen[$0]++'
}

# Print the unique directories holding those files (what inotifyd watches -
# watching the directory survives atomic rename-replace saves that certbot/SWAG
# and editors use).
cert_watch_dirs() {
    cert_watch_files | while IFS= read -r _f; do
        dirname "$_f"
    done | awk '!seen[$0]++'
}

# Print a change fingerprint for the watched cert files - one "path=mtime:size"
# line each. stat follows symlinks (-L) so both a certbot live->archive re-link
# and an in-place overwrite change the value; a file that cannot be stat'd
# contributes "=MISSING" so appearing/disappearing counts as a change too. Used
# by the CERT_WATCH_INTERVAL poller (svc-cert-poll) on filesystems where inotify
# can't observe changes (e.g. NFS-backed cert directories).
cert_watch_fingerprint() {
    cert_watch_files | while IFS= read -r _f; do
        if _s="$(stat -L -c '%Y:%s' "$_f" 2>/dev/null)"; then
            printf '%s=%s\n' "$_f" "$_s"
        else
            printf '%s=MISSING\n' "$_f"
        fi
    done
}

# Print the unique basenames (space-separated on one line) so cert-reload can
# filter inotifyd directory events down to the files we actually care about.
cert_watch_basenames() {
    cert_watch_files | while IFS= read -r _f; do
        basename "$_f"
    done | awk '!seen[$0]++' | tr '\n' ' '
}

# Send ocserv a SIGHUP so it reloads config + certificates. ocserv is the
# process supervised by the svc-ocserv s6 longrun, so s6-svc -h targets exactly
# the ocserv main process (not the sec-mod or per-connection workers).
cert_reload_ocserv() {
    _svc="${S6_SVSCANDIR:-/run/service}/svc-ocserv"
    if [ ! -d "$_svc" ]; then
        log_error "[CERT-RELOAD] ocserv service dir $_svc not found; is ocserv running?"
        return 1
    fi
    # Resolve s6-svc explicitly: a manual `docker exec ... cert-reload` does not
    # have the s6 /command dir on PATH, only the service scripts do.
    _s6svc="$(command -v s6-svc 2>/dev/null || true)"
    [ -n "$_s6svc" ] || { [ -x /command/s6-svc ] && _s6svc=/command/s6-svc; }
    if [ -z "$_s6svc" ]; then
        log_error "[CERT-RELOAD] s6-svc not found; cannot signal ocserv"
        return 1
    fi
    if "$_s6svc" -h "$_svc"; then
        log "[CERT-RELOAD] Sent SIGHUP to ocserv; new connections use the reloaded certificate"
        return 0
    fi
    log_error "[CERT-RELOAD] Failed to signal ocserv via s6-svc"
    return 1
}
