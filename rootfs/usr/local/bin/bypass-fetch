#!/bin/sh
# shellcheck shell=sh
#
# Fetch destination-bypass pool lists from configured sources, publish them
# ATOMICALLY into $VPN_BYPASS_POOLS_DIR and hot-reload the pools that changed.
#
# Sources file ($VPN_BYPASS_SOURCES_FILE): one "<pool> <url-or-path>" per line,
# '#' comments allowed. Several lines for the same pool are merged (validated,
# deduplicated). A source may be an http(s):// URL (fetched with wget) or a
# local file path. Only plain CIDR-per-line sources are supported - that is
# what ipdeny.com zone files, country-ip-blocks dumps and antifilter lists all
# serve, and what any external aggregator can produce.
#
# Per pool, per run:
#   * a source that cannot be fetched - or that yields not a single valid
#     CIDR (an HTML error page, a truncated download) - is IGNORED with a
#     warning; the remaining sources still count;
#   * if EVERY source failed, the published list is left untouched
#     (last-known-good) and the exit status is non-zero;
#   * an unchanged result is not republished (no pointless reload churn);
#   * every successful fetch - changed or not - touches a marker file
#     (.<pool>.stamp next to the list), so freshness checks can tell "the
#     upstream list has not changed in days" apart from "fetching is broken";
#   * publishing is write-tmp + mv, so a concurrent reload (or the
#     svc-bypass-watch watcher) never reads a half-written file.
#
# Run it manually:   docker exec <container> bypass-fetch [pool ...]
#                    (no arguments = fetch every pool that has sources)
# Or automatically:  set VPN_BYPASS_UPDATE_INTERVAL=<seconds> and the
#                    svc-bypass-fetch service runs this on that interval.

set -u

. /usr/local/bin/backend-functions

if [ -z "$vpn_bypass_sources_file" ]; then
    log_error "[BYPASS-FETCH] VPN_BYPASS_SOURCES_FILE is not set; nothing to fetch"
    exit 1
fi
if [ ! -f "$vpn_bypass_sources_file" ]; then
    log_error "[BYPASS-FETCH] Sources file $vpn_bypass_sources_file not found"
    exit 1
fi
if [ ! -f "$vpngw_state_dir/bypass_pools" ]; then
    log_error "[BYPASS-FETCH] Destination bypass is not active; not fetching"
    exit 1
fi

tmp_dir="/tmp/bypass-fetch.$$"
mkdir -p "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT

# "pool source" lines, comments stripped.
sed 's/#.*//' "$vpn_bypass_sources_file" | awk 'NF >= 2 { print $1, $2 }' > "$tmp_dir/sources"

# Warn once about sources for pools that are not configured (not attached to
# any user/gateway), then ignore them.
awk '{ print $1 }' "$tmp_dir/sources" | sort -u | while read -r p; do
    grep -qx "$p" "$vpngw_state_dir/bypass_pools" \
        || log_error "[BYPASS-FETCH] Warning: sources configured for pool '$p', but no user or gateway is attached to it; skipping"
done

if [ $# -eq 0 ]; then
    # shellcheck disable=SC2046
    set -- $(awk '{ print $1 }' "$tmp_dir/sources" | sort -u)
fi
if [ $# -eq 0 ]; then
    log_error "[BYPASS-FETCH] No sources defined in $vpn_bypass_sources_file"
    exit 1
fi

rc=0
for pool in "$@"; do
    if ! grep -qx "$pool" "$vpngw_state_dir/bypass_pools"; then
        continue
    fi
    if ! grep -q "^$pool " "$tmp_dir/sources"; then
        log_error "[BYPASS-FETCH] Pool '$pool' has no sources in $vpn_bypass_sources_file"
        rc=1
        continue
    fi

    : > "$tmp_dir/merged"
    ok_sources=0
    while read -r p src; do
        [ "$p" = "$pool" ] || continue
        case "$src" in
            http://*|https://*)
                if ! wget -q -T 30 -O "$tmp_dir/raw" "$src"; then
                    log_error "[BYPASS-FETCH] Warning: pool '$pool': cannot fetch $src; ignoring this source"
                    continue
                fi
                ;;
            *)
                if ! cat "$src" > "$tmp_dir/raw" 2>/dev/null; then
                    log_error "[BYPASS-FETCH] Warning: pool '$pool': cannot read $src; ignoring this source"
                    continue
                fi
                ;;
        esac
        bypass_pool_entries "$tmp_dir/raw" | awk '$1 != "!" { print $2 }' > "$tmp_dir/valid"
        if [ ! -s "$tmp_dir/valid" ]; then
            log_error "[BYPASS-FETCH] Warning: pool '$pool': no valid entries from $src (error page or wrong format?); ignoring this source"
            continue
        fi
        cat "$tmp_dir/valid" >> "$tmp_dir/merged"
        ok_sources=$((ok_sources + 1))
    done < "$tmp_dir/sources"

    if [ "$ok_sources" -eq 0 ]; then
        log_error "[BYPASS-FETCH] Pool '$pool': every source failed; keeping the published list"
        rc=1
        continue
    fi

    sort -u "$tmp_dir/merged" > "$tmp_dir/new"
    # The fetch itself succeeded - record that, whether or not the content
    # changed. The stamp lives in the pools dir (persists across restarts);
    # the reload watcher ignores non-.list names, and a read-only pools dir
    # just leaves freshness checks on the list's own mtime.
    touch "$vpn_bypass_pools_dir/.$pool.stamp" 2>/dev/null || true
    # Skip publish + reload when the entry set is unchanged (compare against
    # the published list without our generated header comments).
    if [ -f "$vpn_bypass_pools_dir/$pool.list" ] \
        && sed 's/#.*//' "$vpn_bypass_pools_dir/$pool.list" | awk 'NF { print $1 }' | sort -u \
            | cmp -s - "$tmp_dir/new"; then
        log "[BYPASS-FETCH] Pool '$pool': unchanged ($(wc -l < "$tmp_dir/new") entries)"
        continue
    fi
    # Stage NEXT TO the target, then rename: mv from /tmp would cross
    # filesystems and silently degrade to a non-atomic copy. The watcher
    # ignores the .tmp name, so only the rename triggers a reload.
    if ! {
        printf '# generated by bypass-fetch on %s from %s source(s); do not edit\n' \
            "$(date '+%Y-%m-%d %H:%M:%S')" "$ok_sources"
        cat "$tmp_dir/new"
    } > "$vpn_bypass_pools_dir/$pool.list.tmp" 2>/dev/null; then
        log_error "[BYPASS-FETCH] Pool '$pool': cannot publish to $vpn_bypass_pools_dir (read-only mount?)"
        rc=1
        continue
    fi
    mv "$vpn_bypass_pools_dir/$pool.list.tmp" "$vpn_bypass_pools_dir/$pool.list"
    log "[BYPASS-FETCH] Pool '$pool': published $(wc -l < "$tmp_dir/new") entries from $ok_sources source(s)"
    /usr/local/bin/bypass-reload "$pool" || rc=1
done

exit $rc
