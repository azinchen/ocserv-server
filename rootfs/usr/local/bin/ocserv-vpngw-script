#!/bin/sh
# shellcheck shell=sh
#
# ocserv connect/disconnect hook for per-user gateway routing (VPN_USER_GATEWAY /
# VPN_USER_GATEWAY_FILE).
#
# ocserv runs this script with the session in the environment: REASON
# (connect|disconnect), USERNAME, IP_REMOTE (assigned IPv4) and IPV6_REMOTE
# (assigned IPv6, if any). On connect we install a source policy rule steering
# the session's address to its gateway's routing table and register the address
# in the matching kill-switch set; on disconnect we remove them. Every session
# is recorded under $vpngw_state_dir/sessions/<ip4> (username, gateway, IPs,
# bypass pools) so vpngw-reload can re-apply mapping changes - gateway and
# destination-bypass alike - to live sessions without a restart.
#
# State written by init-vpngw lives in $vpngw_state_dir:
#   gateways               "name table gw4 gw6|-" per named gateway
#   users                  "username gwname" per mapped user
#   user-connect-script    original user hook to chain-call (optional)
#   user-disconnect-script original user hook to chain-call (optional)
#
# The per-session apply/cleanup primitives live in backend-functions and are
# shared with vpngw-reload; a flock serialises them against concurrent
# connect/disconnect events and reloads.
#
# Fail-closed: if the routing rule or kill-switch entry cannot be installed on
# connect for a mapped user, we exit non-zero so ocserv REJECTS the session
# instead of letting the user's traffic fall through to the default gateway.

set -u

. /usr/local/bin/backend-functions

reason="${REASON:-}"
username="${USERNAME:-}"
ip4="${IP_REMOTE:-}"
ip6="${IPV6_REMOTE:-}"
ip6="${ip6%%/*}"

lock="$vpngw_state_dir/vpngw.lock"
sess_dir="$vpngw_state_dir/sessions"
sess_file=""
[ -n "$ip4" ] && sess_file="$sess_dir/$ip4"

# Chain-call the user's original connect/disconnect script, if one was
# configured in ocserv.conf before we installed our hook.
run_user_script() {
    script_file="$vpngw_state_dir/user-$reason-script"
    [ -f "$script_file" ] || return 0
    user_script="$(cat "$script_file")"
    [ -n "$user_script" ] || return 0
    "$user_script"
}

# Feature disabled (no users file) or no event: nothing to do beyond the user hook
if [ ! -f "$vpngw_state_dir/users" ] || [ -z "$reason" ]; then
    run_user_script
    exit $?
fi

case "$reason" in
    connect)
        [ -n "$username" ] || { run_user_script; exit $?; }
        gwname="$(awk -v u="$username" '$1 == u { print $2; exit }' "$vpngw_state_dir/users")"

        # Apply under the lock. Mapped users get a per-session rule; unmapped
        # users are only recorded (gateway "-") so a later reload can map them.
        # Destination-bypass membership applies to mapped AND unmapped users
        # (unmapped users inherit the default gateway's pools) and is as
        # fail-closed as the gateway rules: a session we cannot register is
        # rejected rather than silently routed without its bypass.
        if ! (
            flock 9
            [ -n "$ip4" ] && vpngw_cleanup_session "$ip4" "$ip6"
            if [ -n "$gwname" ]; then
                if ! vpngw_apply_session "$username" "$gwname" "$ip4" "$ip6"; then
                    vpngw_cleanup_session "$ip4" "$ip6"
                    exit 1
                fi
            fi
            bypass_pools="$(bypass_session_pools "$username" "${gwname:--}")"
            if [ -n "$bypass_pools" ]; then
                # shellcheck disable=SC2086
                if ! bypass_apply_session "$ip4" "$ip6" $bypass_pools; then
                    vpngw_cleanup_session "$ip4" "$ip6"
                    exit 1
                fi
                log "[VPNGW-HOOK] User '$username' ($ip4${ip6:+, $ip6}) bypasses the gateway for pools: $bypass_pools"
            fi
            if [ -n "$sess_file" ]; then
                mkdir -p "$sess_dir"
                bp_rec="$(printf '%s' "$bypass_pools" | tr ' ' '+')"
                printf '%s %s %s %s %s\n' \
                    "$username" "${gwname:--}" "$ip4" "${ip6:--}" "${bp_rec:--}" > "$sess_file"
            fi
        ) 9>"$lock"; then
            log_error "[VPNGW-HOOK] Failed to route user '$username' (ip $ip4); rejecting session"
            exit 1
        fi
        run_user_script
        exit $?
        ;;
    disconnect)
        (
            flock 9
            [ -n "$ip4" ] && vpngw_cleanup_session "$ip4" "$ip6"
            [ -n "$sess_file" ] && rm -f "$sess_file"
        ) 9>"$lock"
        log "[VPNGW-HOOK] User '$username' ($ip4${ip6:+, $ip6}) gateway rules removed"
        run_user_script || true
        exit 0
        ;;
    *)
        run_user_script
        exit $?
        ;;
esac
