#!/bin/sh
# shellcheck shell=sh
#
# Rebuild the per-user gateway map from VPN_USER_GATEWAY (env) + the file named
# by VPN_USER_GATEWAY_FILE, and apply the changes to currently-connected
# sessions IN PLACE (no reconnect). Safe to run repeatedly.
#
# Run it manually:   docker exec <container> vpngw-reload
# Or automatically:  set VPN_USER_GATEWAY_WATCH=1 and the svc-vpngw-watch
#                    service re-runs it whenever the map file changes.
#
# The new map is validated in full before any live state is touched: an invalid
# file aborts the reload and leaves connected sessions exactly as they were.

set -u

. /usr/local/bin/backend-functions

# When invoked by inotifyd as a directory watcher the args are: EVENTS DIR
# SUBFILE. Ignore events for other files in the watched directory.
if [ -n "${3:-}" ] && [ -n "$vpn_user_gateway_file" ]; then
    [ "$3" = "$(basename "$vpn_user_gateway_file")" ] || exit 0
fi

if [ ! -d "$vpngw_state_dir" ] || [ ! -f "$vpngw_state_dir/users" ]; then
    log_error "[VPNGW-RELOAD] Per-user gateway mode is not active; nothing to reload"
    exit 1
fi

(
    flock 9

    if ! vpngw_build_users; then
        log_error "[VPNGW-RELOAD] Invalid map; live sessions left unchanged"
        exit 1
    fi

    # Reconcile live sessions: for each recorded session whose gateway changed,
    # remove the old per-session rules and install the new ones in place. The
    # recorded gateway is "-" when the session is currently unmapped (it follows
    # the subnet/default route).
    changed=0
    if [ -d "$vpngw_state_dir/sessions" ]; then
        for rec in "$vpngw_state_dir"/sessions/*; do
            [ -f "$rec" ] || continue
            read -r s_user s_oldgw s_ip4 s_ip6 < "$rec" || continue
            [ "$s_ip6" = "-" ] && s_ip6=""

            newgw="$(awk -v u="$s_user" '$1 == u { print $2; exit }' "$vpngw_state_dir/users")"
            [ -z "$newgw" ] && newgw="-"
            [ "$newgw" = "$s_oldgw" ] && continue

            vpngw_cleanup_session "$s_ip4" "$s_ip6"
            if [ "$newgw" != "-" ]; then
                if vpngw_apply_session "$s_user" "$newgw" "$s_ip4" "$s_ip6"; then
                    log "[VPNGW-RELOAD] User '$s_user' ($s_ip4) moved '$s_oldgw' -> '$newgw'"
                else
                    vpngw_cleanup_session "$s_ip4" "$s_ip6"
                    log_error "[VPNGW-RELOAD] Could not apply gateway '$newgw' for '$s_user' ($s_ip4); left with no gateway"
                    newgw="-"
                fi
            else
                log "[VPNGW-RELOAD] User '$s_user' ($s_ip4) unmapped; follows default/subnet route"
            fi
            # Re-register destination-bypass membership for the new gateway
            # (cleanup above removed it; inherited pools follow the gateway).
            bp="$(bypass_session_pools "$s_user" "$newgw")"
            if [ -n "$bp" ]; then
                # shellcheck disable=SC2086
                bypass_apply_session "$s_ip4" "$s_ip6" $bp \
                    || log_error "[VPNGW-RELOAD] Warning: could not re-apply bypass pools for '$s_user' ($s_ip4)"
            fi
            printf '%s %s %s %s\n' "$s_user" "$newgw" "$s_ip4" "${s_ip6:--}" > "$rec"
            changed=$((changed + 1))
        done
    fi
    log "[VPNGW-RELOAD] Reload complete; $changed live session(s) updated"
) 9>"$vpngw_state_dir/vpngw.lock"
