#!/command/with-contenv sh
# shellcheck shell=sh

set -eu

. /usr/local/bin/backend-functions

# Optional "gateway mode": send the VPN client subnet OUT through an upstream
# gateway container (e.g. a NordVPN container running FORWARD_FROM) instead of
# this container's own default route.
#
# We use source-based policy routing rather than replacing the default route, so
# the inbound listener and this container's own traffic keep using the default
# route: only packets FROM the client subnet are steered to the gateway. The
# routing decision happens before init-nat's masquerade, so the "from <subnet>"
# match still sees the real client source address.
#
# Two layers are supported and can be combined:
#   * VPN_GATEWAY / VPN_GATEWAY6           - default gateway for the whole subnet
#   * VPN_GATEWAYS + VPN_USER_GATEWAY      - per-user gateways: named gateways get
#     their own routing table and kill-switch set here; the actual per-session
#     rules are added/removed by /usr/local/bin/ocserv-vpngw-script, which ocserv
#     runs on client connect/disconnect (the session's source IP is only known
#     then). Users not listed in VPN_USER_GATEWAY follow VPN_GATEWAY if set,
#     otherwise the container's default route. The reserved gateway name
#     "direct" sends a user out the default route even when VPN_GATEWAY is set.

conf=/etc/ocserv/ocserv.conf

# Undo our managed edits in ocserv.conf (managed block + commented-out user
# hooks). Only touches the file if our markers are present.
restore_config() {
    [ -f "$conf" ] || return 0
    if grep -q 'ocserv-vpngw managed block' "$conf" || grep -q '^#\[vpngw\]# ' "$conf"; then
        sed -i '/^# BEGIN ocserv-vpngw managed block/,/^# END ocserv-vpngw managed block/d' "$conf"
        sed -i 's/^#\[vpngw\]# //' "$conf"
        log "[INIT-VPNGW] Removed managed connect-script hooks from ocserv.conf"
    fi
}

rm -rf "$vpngw_state_dir"

# Remove destination-bypass machinery from a previous run (rebuilt below when
# configured). Delete our fwmark policy rules by priority alone - with per-pool
# targets they may look up the main table or any gateway table.
nft delete table inet ocserv_bypass 2>/dev/null || true
n=0
while [ "$n" -lt 32 ] && ip rule del priority "$vpn_bypass_rule_prio" 2>/dev/null; do
    n=$((n + 1))
done
n=0
while [ "$n" -lt 32 ] && ip -6 rule del priority "$vpn_bypass_rule_prio" 2>/dev/null; do
    n=$((n + 1))
done

# Gateway mode is active if any egress control is configured. A v6 value of
# "direct" (IPv6 via ISP) or unset counts as "not controlling IPv6", same as a
# plain server; "block" or an IP does control it and activates the mode.
gw_active=0
[ -n "$vpn_gateway" ] && gw_active=1
[ -n "$vpn_gateways" ] && gw_active=1
[ -n "$vpn_gateways_file" ] && gw_active=1
case "$vpn_gateway6" in ""|direct) ;; *) gw_active=1 ;; esac
if [ "$gw_active" = 0 ]; then
    restore_config
    if [ -n "$vpn_gateway_bypass$vpn_gateways_bypass$vpn_user_bypass$vpn_user_bypass_file$vpn_bypass_targets" ]; then
        log_error "[INIT-VPNGW] Warning: destination-bypass settings ignored - no gateway is configured, so clients already exit direct"
    fi
    log "[INIT-VPNGW] No gateway configured; clients exit via the default route"
    exit 0
fi

mkdir -p "$vpngw_state_dir"

table="$vpn_gateway_table"
prio="$vpn_gateway_rule_prio"

# Per-user mode is active when a static map (VPN_USER_GATEWAY) and/or a map file
# (VPN_USER_GATEWAY_FILE) is configured. With a file configured the hook is
# installed even when the map is currently empty, so mappings can be added at
# runtime and applied with vpngw-reload (no container restart).
if [ -n "$vpn_user_gateway" ] || [ -n "$vpn_user_gateway_file" ]; then
    vpngw_user_mode=1
else
    vpngw_user_mode=0
fi

# ---- Named gateways (per-user routing tables) ------------------------------
# Definitions come from VPN_GATEWAYS / VPN_GATEWAYS6 (env) and/or
# VPN_GATEWAYS_FILE (one "name ipv4 [ipv6]" per line); the file wins per field.
if [ -n "$vpn_gateways" ] || [ -n "$vpn_gateways_file" ]; then
    vpngw_gateways_merged "$vpn_gateways" "$vpn_gateways6" "$vpn_gateways_file" \
        > "$vpngw_state_dir/gateways.tmp"
    : > "$vpngw_state_dir/gateways.src"
    idx=0
    while read -r name gw4 gw6; do
        [ -n "$name" ] || continue
        # Names are embedded in nft set identifiers (gw_<name>_v4) and stored in
        # whitespace-separated state files, hence the restricted charset.
        case "$name" in
            direct|block|drop)
                log_error "[INIT-VPNGW] VPN_GATEWAYS: '$name' is a reserved gateway name"
                exit 1
                ;;
            -*|*[!a-zA-Z0-9_-]*)
                log_error "[INIT-VPNGW] VPN_GATEWAYS: invalid gateway name '$name' (use letters, digits, _, -; must not start with -)"
                exit 1
                ;;
        esac
        # gw4/gw6 are each an IP, a DNS name or "block" (block that family); gw4
        # "none" means no IPv4 was given at all. A gateway must route a family.
        if [ "$gw4" = "none" ]; then
            log_error "[INIT-VPNGW] Gateway '$name' has no IPv4 address; use 'block' for an IPv6-only gateway"
            exit 1
        fi
        if [ "$gw4" = "block" ] && [ "$gw6" = "block" ]; then
            log_error "[INIT-VPNGW] Gateway '$name' blocks both IPv4 and IPv6; it would route nothing"
            exit 1
        fi
        # Record the source tokens (may be DNS names) so svc-vpngw-gw-resolve can
        # re-resolve them later, then resolve names to addresses for routing.
        printf '%s %s %s\n' "$name" "$gw4" "$gw6" >> "$vpngw_state_dir/gateways.src"
        rgw4="$gw4"
        if ! gw_is_literal "$gw4"; then
            if ! rgw4="$(gw_resolve_one -4 "$gw4")"; then
                log_error "[INIT-VPNGW] Gateway '$name': cannot resolve IPv4 host '$gw4'"
                exit 1
            fi
            log "[INIT-VPNGW] Gateway '$name': resolved IPv4 $gw4 -> $rgw4"
        fi
        rgw6="$gw6"
        if ! gw_is_literal "$gw6"; then
            if ! rgw6="$(gw_resolve_one -6 "$gw6")"; then
                log_error "[INIT-VPNGW] Gateway '$name': cannot resolve IPv6 host '$gw6'"
                exit 1
            fi
            log "[INIT-VPNGW] Gateway '$name': resolved IPv6 $gw6 -> $rgw6"
        fi
        idx=$((idx + 1))
        gw_table=$((vpn_gateway_table + idx))
        log "[INIT-VPNGW] Gateway '$name': table $gw_table (v4 $rgw4 / v6 $rgw6)"
        if [ "$rgw4" != "block" ]; then
            ip route replace default via "$rgw4" table "$gw_table"
        fi
        if [ "$rgw6" != "block" ]; then
            ip -6 route replace default via "$rgw6" table "$gw_table" \
                || log_error "[INIT-VPNGW] Warning: could not add IPv6 route for gateway '$name'"
        fi
        printf '%s %s %s %s\n' "$name" "$gw_table" "$rgw4" "$rgw6" >> "$vpngw_state_dir/gateways"
    done < "$vpngw_state_dir/gateways.tmp"
    rm -f "$vpngw_state_dir/gateways.tmp"
fi

# ---- Per-user map (VPN_USER_GATEWAY and/or VPN_USER_GATEWAY_FILE) -----------
if [ "$vpngw_user_mode" = 1 ]; then
    mkdir -p "$vpngw_state_dir/sessions"
    if ! vpngw_build_users; then
        log_error "[INIT-VPNGW] Invalid user-gateway map; aborting"
        exit 1
    fi
    while read -r user gwname; do
        [ -n "$user" ] && log "[INIT-VPNGW] User '$user' routes via gateway '$gwname'"
    done < "$vpngw_state_dir/users"
    if [ -n "$vpn_user_gateway_file" ]; then
        log "[INIT-VPNGW] User-gateway map file: $vpn_user_gateway_file (reload with vpngw-reload)"
    fi
fi

# ---- Destination-bypass pools ----------------------------------------------
# Traffic whose DESTINATION is in a named pool (a CIDR list file
# $VPN_BYPASS_POOLS_DIR/<name>.list) escapes the session's gateway and goes to
# the pool's TARGET (VPN_BYPASS_TARGETS): "direct" (the default - the main
# table / ISP, e.g. a cascade node in a country whose local destinations must
# not take the upstream tunnel), a named gateway (matched traffic takes THAT
# gateway instead of the session's), or "block" ("drop" is an alias; matched
# destinations are rejected - a destination blocklist). Pools attach per user
# (VPN_USER_BYPASS[_FILE]; "none" opts a user out), per named gateway
# (VPN_GATEWAYS_BYPASS, inherited by its users) or to the default gateway's
# unmapped users (VPN_GATEWAY_BYPASS). Multiple pools join with '+'.
# Mechanism: a prerouting chain (table inet ocserv_bypass) fwmarks matching
# client traffic with its pool's target mark; per-target fwmark policy rules
# stronger than every gateway rule route it, and the kill switch handles each
# mark explicitly - a pool match is a deliberate instruction and wins even
# over a blocked family.

bypass_pools_used=""
bypass_note_pool() { # validate one pool name ($1) from context $2; record it
    case "$1" in
        none)
            log_error "[INIT-VPNGW] $2: 'none' is reserved (per-user opt-out), not a pool name"
            exit 1
            ;;
        -*|*[!a-zA-Z0-9_-]*)
            log_error "[INIT-VPNGW] $2: invalid pool name '$1' (use letters, digits, _, -; must not start with -)"
            exit 1
            ;;
    esac
    case " $bypass_pools_used " in
        *" $1 "*) ;;
        *) bypass_pools_used="$bypass_pools_used $1" ;;
    esac
}

if [ -n "$vpn_gateway_bypass$vpn_gateways_bypass$vpn_user_bypass$vpn_user_bypass_file" ]; then
    # The fwmark rule must be numerically stronger than the per-user rules or
    # bypassed packets would still hit their gateway table first.
    if ! ( : "$((vpn_bypass_mark))" ) 2>/dev/null || [ "$((vpn_bypass_mark))" -le 0 ]; then
        log_error "[INIT-VPNGW] VPN_BYPASS_MARK: '$vpn_bypass_mark' is not a positive number (decimal or 0x hex)"
        exit 1
    fi
    if ! { [ "$vpn_bypass_rule_prio" -gt 0 ] \
        && [ "$vpn_bypass_rule_prio" -lt "$vpn_gateway_user_rule_prio" ]; } 2>/dev/null; then
        log_error "[INIT-VPNGW] VPN_BYPASS_RULE_PRIO ($vpn_bypass_rule_prio) must be a number below VPN_GATEWAY_USER_RULE_PRIO ($vpn_gateway_user_rule_prio)"
        exit 1
    fi

    # Default-gateway pools: apply to unmapped users. Meaningless when unmapped
    # users already exit via the ISP (no VPN_GATEWAY and no controlled IPv6).
    bypass_default=""
    if [ -n "$vpn_gateway_bypass" ]; then
        if [ -z "$vpn_gateway" ] && { [ -z "$vpn_gateway6" ] || [ "$vpn_gateway6" = "direct" ]; }; then
            log_error "[INIT-VPNGW] Warning: VPN_GATEWAY_BYPASS ignored - unmapped users already exit direct (no VPN_GATEWAY)"
        else
            bypass_default="$(echo "$vpn_gateway_bypass" | tr '+' ' ')"
            for p in $bypass_default; do
                bypass_note_pool "$p" "VPN_GATEWAY_BYPASS"
            done
        fi
    fi

    # Per-gateway pools: inherited by every user mapped to that gateway.
    if [ -n "$vpn_gateways_bypass" ]; then
        if [ ! -f "$vpngw_state_dir/gateways" ] || [ "$vpngw_user_mode" != 1 ]; then
            log_error "[INIT-VPNGW] VPN_GATEWAYS_BYPASS needs named gateways (VPN_GATEWAYS) and the per-user map (VPN_USER_GATEWAY[_FILE])"
            exit 1
        fi
        kv_pairs "$vpn_gateways_bypass" > "$vpngw_state_dir/bypass_gws.tmp"
        : > "$vpngw_state_dir/bypass_gws"
        while read -r gname plist; do
            [ -n "$gname" ] || continue
            if ! awk -v n="$gname" '$1 == n { f = 1 } END { exit !f }' "$vpngw_state_dir/gateways"; then
                log_error "[INIT-VPNGW] VPN_GATEWAYS_BYPASS: unknown gateway '$gname'"
                exit 1
            fi
            plist="$(echo "$plist" | tr '+' ' ')"
            for p in $plist; do
                bypass_note_pool "$p" "VPN_GATEWAYS_BYPASS"
            done
            printf '%s %s\n' "$gname" "$plist" >> "$vpngw_state_dir/bypass_gws"
        done < "$vpngw_state_dir/bypass_gws.tmp"
        rm -f "$vpngw_state_dir/bypass_gws.tmp"
    fi

    # Per-user pools: strongest attachment; "none" opts the user out of any
    # inherited bypass. Needs the connect hook, i.e. per-user mode (an empty
    # VPN_USER_GATEWAY_FILE is enough to enable it).
    if [ -n "$vpn_user_bypass" ] || [ -n "$vpn_user_bypass_file" ]; then
        if [ "$vpngw_user_mode" != 1 ]; then
            log_error "[INIT-VPNGW] VPN_USER_BYPASS needs the per-user connect hook; set VPN_USER_GATEWAY or point VPN_USER_GATEWAY_FILE at a file (it may be empty)"
            exit 1
        fi
        kv_merge_env_file "$vpn_user_bypass" "$vpn_user_bypass_file" > "$vpngw_state_dir/bypass_users.tmp"
        : > "$vpngw_state_dir/bypass_users"
        while read -r uname plist; do
            [ -n "$uname" ] || continue
            if [ "$plist" = "none" ]; then
                printf '%s none\n' "$uname" >> "$vpngw_state_dir/bypass_users"
                continue
            fi
            plist="$(echo "$plist" | tr '+' ' ')"
            for p in $plist; do
                bypass_note_pool "$p" "VPN_USER_BYPASS"
            done
            printf '%s %s\n' "$uname" "$plist" >> "$vpngw_state_dir/bypass_users"
        done < "$vpngw_state_dir/bypass_users.tmp"
        rm -f "$vpngw_state_dir/bypass_users.tmp"
    fi
fi

if [ -n "$bypass_pools_used" ]; then
    # shellcheck disable=SC2086 # intentional split: one pool name per line
    printf '%s\n' $bypass_pools_used > "$vpngw_state_dir/bypass_pools"
    if [ "$vpngw_user_mode" = 1 ]; then
        echo user > "$vpngw_state_dir/bypass_mode"
    else
        echo subnet > "$vpngw_state_dir/bypass_mode"
    fi
    [ -n "$bypass_default" ] && printf '%s\n' "$bypass_default" > "$vpngw_state_dir/bypass_default"

    # Per-pool targets (VPN_BYPASS_TARGETS, "pool=target,..."). Validate every
    # entry: the pool must be attached somewhere above, the target must be
    # "direct", "block"/"drop" or a defined named gateway.
    kv_pairs "$vpn_bypass_targets" \
        | awk '{ if ($2 == "drop") $2 = "block"; print $1, $2 }' \
        > "$vpngw_state_dir/bypass_targets.map"
    while read -r pname ptarget; do
        [ -n "$pname" ] || continue
        case " $bypass_pools_used " in
            *" $pname "*) ;;
            *)
                log_error "[INIT-VPNGW] VPN_BYPASS_TARGETS: pool '$pname' is not attached anywhere (VPN_GATEWAY_BYPASS / VPN_GATEWAYS_BYPASS / VPN_USER_BYPASS)"
                exit 1
                ;;
        esac
        case "$ptarget" in
            direct|block) ;;
            *)
                if ! awk -v n="$ptarget" '$1 == n { f = 1 } END { exit !f }' \
                    "$vpngw_state_dir/gateways" 2>/dev/null; then
                    log_error "[INIT-VPNGW] VPN_BYPASS_TARGETS: unknown target '$ptarget' for pool '$pname' (use 'direct', 'block' or a VPN_GATEWAYS name)"
                    exit 1
                fi
                ;;
        esac
    done < "$vpngw_state_dir/bypass_targets.map"

    # Resolve every pool to "pool target mark" (unlisted pools default to
    # "direct"). Marks: the base VPN_BYPASS_MARK for "direct"; every other
    # target gets base+1, base+2... in sorted order (deterministic per boot).
    bypass_extra_targets="$(awk '$2 != "direct" { print $2 }' \
        "$vpngw_state_dir/bypass_targets.map" | sort -u)"
    : > "$vpngw_state_dir/bypass_targets"
    for p in $bypass_pools_used; do
        t="$(awk -v p="$p" '$1 == p { print $2; exit }' "$vpngw_state_dir/bypass_targets.map")"
        t="${t:-direct}"
        if [ "$t" = "direct" ]; then
            m="$((vpn_bypass_mark))"
        else
            i="$(printf '%s\n' "$bypass_extra_targets" | awk -v t="$t" '$1 == t { print NR; exit }')"
            m="$((vpn_bypass_mark + i))"
        fi
        printf '%s %s %s\n' "$p" "$t" "$m" >> "$vpngw_state_dir/bypass_targets"
    done
    rm -f "$vpngw_state_dir/bypass_targets.map"

    if ! bypass_load_table; then
        log_error "[INIT-VPNGW] Could not install the bypass marking chain; aborting"
        exit 1
    fi
    for p in $bypass_pools_used; do
        bypass_load_pool "$p" || true
    done

    # One policy-rule pair per distinct target: "direct" -> the main table; a
    # named gateway -> its routing table (only the families it routes); "block"
    # -> no rule at all (marked packets are rejected by the kill switch, the
    # same stance as a blocked gateway family).
    awk '!seen[$3]++ { print $2, $3 }' "$vpngw_state_dir/bypass_targets" \
        > "$vpngw_state_dir/bypass_rules.tmp"
    while read -r t m; do
        case "$t" in
            direct)
                ip rule add fwmark "$m" lookup main priority "$vpn_bypass_rule_prio"
                ip -6 rule add fwmark "$m" lookup main priority "$vpn_bypass_rule_prio" \
                    || log_error "[INIT-VPNGW] Warning: could not add the IPv6 bypass policy rule"
                ;;
            block) ;;
            *)
                tline="$(awk -v n="$t" '$1 == n { print; exit }' "$vpngw_state_dir/gateways")"
                ttbl="$(echo "$tline" | awk '{ print $2 }')"
                tg4="$(echo "$tline" | awk '{ print $3 }')"
                tg6="$(echo "$tline" | awk '{ print $4 }')"
                if [ "$tg4" != "block" ]; then
                    ip rule add fwmark "$m" lookup "$ttbl" priority "$vpn_bypass_rule_prio"
                fi
                if [ "$tg6" != "block" ]; then
                    ip -6 rule add fwmark "$m" lookup "$ttbl" priority "$vpn_bypass_rule_prio" \
                        || log_error "[INIT-VPNGW] Warning: could not add the IPv6 bypass policy rule for target '$t'"
                fi
                ;;
        esac
    done < "$vpngw_state_dir/bypass_rules.tmp"
    rm -f "$vpngw_state_dir/bypass_rules.tmp"

    while read -r p t m; do
        log "[INIT-VPNGW] Bypass pool '$p' -> $t (mark $m)"
    done < "$vpngw_state_dir/bypass_targets"
    log "[INIT-VPNGW] Destination bypass active ($(cat "$vpngw_state_dir/bypass_mode") mode; pools:$bypass_pools_used; base mark $vpn_bypass_mark prio $vpn_bypass_rule_prio)"
elif [ -n "$vpn_bypass_targets" ]; then
    log_error "[INIT-VPNGW] Warning: VPN_BYPASS_TARGETS ignored - no bypass pool is attached (VPN_GATEWAY_BYPASS / VPN_GATEWAYS_BYPASS / VPN_USER_BYPASS)"
fi

# ---- Subnet default for unmapped users -------------------------------------
# Policy-route the whole client subnet to the default gateway ONLY when it is a
# real IP (or a DNS name resolving to one). "" (ISP) and "block" add no route:
# their traffic uses the main table and the kill switch below either lets it out
# the WAN (ISP) or rejects it. The resolved next-hops are recorded in the
# "subnet" state file (v4 v6; "-" = unset/ISP) so the reconciler can rebuild the
# kill switch when a DNS-named default gateway is re-resolved to a new address.
sub4="-"
case "$vpn_gateway" in
    "")    : ;;
    block) sub4="block" ;;
    *)
        if gw_is_literal "$vpn_gateway"; then
            sub4="$vpn_gateway"
        elif ! sub4="$(gw_resolve_one -4 "$vpn_gateway")"; then
            log_error "[INIT-VPNGW] VPN_GATEWAY: cannot resolve IPv4 host '$vpn_gateway'"
            exit 1
        fi
        log "[INIT-VPNGW] Routing $vpn_subnet via $sub4 (table $table)"
        ip route replace default via "$sub4" table "$table"
        ip rule show | grep -q "from $vpn_subnet lookup $table" \
            || ip rule add from "$vpn_subnet" lookup "$table" priority "$prio"
        ;;
esac
sub6="-"
case "$vpn_gateway6" in
    "")     : ;;
    block)  sub6="block" ;;
    direct) sub6="direct" ;;
    *)
        if gw_is_literal "$vpn_gateway6"; then
            sub6="$vpn_gateway6"
        elif ! sub6="$(gw_resolve_one -6 "$vpn_gateway6")"; then
            log_error "[INIT-VPNGW] VPN_GATEWAY6: cannot resolve IPv6 host '$vpn_gateway6'"
            exit 1
        fi
        log "[INIT-VPNGW] Routing $ipv6_subnet via $sub6 (table $table)"
        ip -6 route replace default via "$sub6" table "$table" \
            || log_error "[INIT-VPNGW] Warning: could not add IPv6 gateway route"
        ip -6 rule show 2>/dev/null | grep -q "from $ipv6_subnet lookup $table" \
            || ip -6 rule add from "$ipv6_subnet" lookup "$table" priority "$prio" \
            || log_error "[INIT-VPNGW] Warning: could not add IPv6 policy rule"
        ;;
esac
printf '%s %s\n' "$sub4" "$sub6" > "$vpngw_state_dir/subnet"

# ---- Kill switch (defense in depth) --------------------------------------
# The policy routes already force client traffic to the gateways, but if a
# route is ever missing the kernel would fall through to the main table and leak
# out the WAN. These nft rules make that explicit and fail-closed:
#   * Per-user gateways: each named gateway gets an address set (filled by the
#     connect hook); traffic from those addresses may exit the WAN ONLY toward
#     that gateway's next-hop and never falls through to the default guard.
#   * "direct" users: an accept set so they bypass the default guard.
#   * v4_block / v6_block: forwarded traffic of a family a user's gateway blocks
#     (or, for IPv6, a gateway that simply has none) is rejected with an ICMP
#     admin-prohibited, so the client fails fast (and falls back to the other
#     family) instead of hanging - and it can't fall through to the subnet guard
#     or the default route. Reject (not drop) because a block is intentional;
#     the next-hop guards stay drop as a silent failsafe against leaks.
#   * Default gateway (IPv4/IPv6): same next-hop guard for the whole subnet.
# A gateway that blocks a family has no gw_<name>_v{4,6} set (its users go to
# v{4,6}_block instead); only routed families get a next-hop guard.
#
# The set declarations and chain rules are built from state (gateways, users,
# subnet) by helpers shared with svc-vpngw-gw-resolve, which rebuilds just the
# chain in place when a DNS-named next-hop is re-resolved to a new address.
if vpngw_load_killswitch; then
    log "[INIT-VPNGW] Kill-switch installed (table inet ocserv_gw)"
else
    log_error "[INIT-VPNGW] Warning: kill-switch nft rules failed to load; relying on policy routing only"
fi

# ---- ocserv connect/disconnect hook ---------------------------------------
# Per-user rules can only be installed when a session gets its IP, so ocserv
# must run our hook on connect/disconnect. We manage the config directives
# ourselves: an existing user-configured script is commented out (with a
# restore marker), recorded in the state dir, and chain-called by our hook.
if [ -f "$vpngw_state_dir/users" ]; then
    if [ ! -f "$conf" ]; then
        log_error "[INIT-VPNGW] $conf not found; cannot install connect-script hook"
        exit 1
    fi
    restore_config
    orig_connect="$(sed -n 's/^connect-script[[:space:]]*=[[:space:]]*//p' "$conf" | head -1 | tr -d '"')"
    orig_disconnect="$(sed -n 's/^disconnect-script[[:space:]]*=[[:space:]]*//p' "$conf" | head -1 | tr -d '"')"
    if [ -n "$orig_connect" ]; then
        printf '%s\n' "$orig_connect" > "$vpngw_state_dir/user-connect-script"
        log "[INIT-VPNGW] Chaining existing connect-script: $orig_connect"
    fi
    if [ -n "$orig_disconnect" ]; then
        printf '%s\n' "$orig_disconnect" > "$vpngw_state_dir/user-disconnect-script"
        log "[INIT-VPNGW] Chaining existing disconnect-script: $orig_disconnect"
    fi
    sed -i 's/^connect-script[[:space:]]*=/#[vpngw]# &/; s/^disconnect-script[[:space:]]*=/#[vpngw]# &/' "$conf"
    cat >> "$conf" <<'EOF'
# BEGIN ocserv-vpngw managed block (added by init-vpngw; do not edit)
connect-script = /usr/local/bin/ocserv-vpngw-script
