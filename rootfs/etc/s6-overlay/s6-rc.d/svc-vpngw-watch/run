#!/command/with-contenv sh
# shellcheck shell=sh
#
# Optional watcher for the per-user gateway map file. When
# VPN_USER_GATEWAY_WATCH=1 and VPN_USER_GATEWAY_FILE is set, re-run vpngw-reload
# whenever the file changes, so edits apply without a container restart.
#
# When watching is disabled (or nothing to watch) the service idles, so it can
# stay in the s6 user bundle unconditionally.

set -eu

. /usr/local/bin/backend-functions

if [ "$vpn_user_gateway_watch" != "1" ]; then
    exec sleep infinity
fi
if [ -z "$vpn_user_gateway_file" ]; then
    log_error "[VPNGW-WATCH] VPN_USER_GATEWAY_WATCH=1 but VPN_USER_GATEWAY_FILE is unset; not watching"
    exec sleep infinity
fi
if [ ! -f "$vpngw_state_dir/users" ]; then
    log_error "[VPNGW-WATCH] Per-user gateway mode is not active; not watching"
    exec sleep infinity
fi

dir="$(dirname "$vpn_user_gateway_file")"
if [ ! -d "$dir" ]; then
    log_error "[VPNGW-WATCH] Directory $dir does not exist; not watching"
    exec sleep infinity
fi

# Apply whatever is on disk now — this catches edits made while we were not
# watching, including editor rename-replace saves that restart this service —
# then watch the directory for changes to the map file. Watching the directory
# (not the file) survives atomic rename-replace saves; vpngw-reload filters
# events to the map file's basename.
/usr/local/bin/vpngw-reload || true
log "[VPNGW-WATCH] Watching $vpn_user_gateway_file for changes"
exec inotifyd /usr/local/bin/vpngw-reload "$dir"
